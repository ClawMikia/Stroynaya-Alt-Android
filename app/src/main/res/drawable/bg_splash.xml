<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark Red base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_abyss" />
        </shape>
    </item>
    <!-- Top-left red bloom -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.1"
                android:centerY="0.08"
                android:endColor="#00000000"
                android:gradientRadius="250dp"
                android:startColor="@color/neon_violet"
                android:type="radial" />
        </shape>
    </item>
    <!-- Bottom-right red bloom -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.92"
                android:centerY="0.94"
                android:endColor="#00000000"
                android:gradientRadius="360dp"
                android:startColor="#33FF0000"
                android:type="radial" />
        </shape>
    </item>
    <!-- Centre subtle red haze -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.5"
                android:endColor="#00000000"
                android:gradientRadius="280dp"
                android:startColor="#1AFF5252"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
